;; -*- mode: emacs-lisp; -*-
;; pi-coding-agent.window-layout
;;
;; Static default of the pi coding agent window layout (also loadable
;; via `M-x purpose-load-window-layout').  `pi-coding-agent/layout'
;; (SPC a i l) generates this layout from
;; `pi-coding-agent/layout-width-ratio' instead of loading this file;
;; keep the values here in sync with that variable's default (0.5).
;;
;; 3-pane layout:
;;
;;   +-------------------------+-------------------------+
;;   | pi-coding-agent-chat    |                         |
;;   | (70% height)            | any                     |
;;   +-------------------------+ buffer                 |
;;   | pi-coding-agent-input   |                         |
;;   | (30% height)            |                         |
;;   +-------------------------+-------------------------+
;;
;; Format: raw window-purpose layout sexp as written by
;; `purpose-save-window-layout'.  Tree nodes are
;;   (split-direction edges children...)  where split-direction is nil
;;   for a side-by-side split and t for a stacked split (the value is
;;   only used to derive the split direction, see
;;   `purpose--split-window').
;; Leaf nodes are window-params plists: :purpose, :purpose-dedicated,
;; :width, :height, :edges — width/height/edges are frame fractions.
;; Purposes pi-chat / pi-input are mapped to the package's modes in the
;; layer's config.el; the right pane uses the `edit' purpose, which
;; almost always has matching buffers (file-visiting buffers classify
;; as edit), so the fill loop fills it instead of creating a dummy
;; placeholder.
(nil (0 0 1200 800)
     (t (0 0 600 800)
        (:purpose pi-chat :purpose-dedicated t
                  :width 0.5 :height 0.7 :edges (0.0 0.0 0.5 0.7))
        (:purpose pi-input :purpose-dedicated t
                  :width 0.5 :height 0.3 :edges (0.0 0.5 0.7 1.0)))
     (:purpose edit :purpose-dedicated nil
                :width 0.5 :height 1.0 :edges (0.5 0.0 1.0 1.0)))
