(defvar persp-mode nil)

(ert-deftest pilish-switch-session-syncs-labels-from-prefetched-metadata ()
  "Merge the local scan before label sync and listing."
  (let ((events nil)
        (persp-mode t)
        (pilish//registry nil))
    (provide 'pilish)
    (cl-letf (((symbol-function 'pilish//session-root)
               (lambda () "/tmp/pilish-session-root"))
              ((symbol-function 'pilish//local-scan-prefetch-start)
               (lambda (_root) (push 'start events) 'fake-state))
              ((symbol-function 'pilish//sync-labels)
               (lambda () (push 'labels events)))
              ((symbol-function 'pilish//local-scan-prefetch-finish)
               (lambda (_state) (push 'await events) t))
              ((symbol-function 'pilish//local-scan-prefetch-cancel)
               (lambda (_state) (push 'cleanup events)))
              ((symbol-function 'pilish//known-remote-prefixes)
               (lambda () nil))
              ((symbol-function 'pilish//session-targets)
               (lambda (&rest _)
                 (push 'targets events)
                 (cons nil (list (cons "candidate"
                                       '(:entry (:file "/tmp/session.jsonl")
                                         :label "candidate" :opened nil))))))
              ((symbol-function 'pilish//sort-targets)
               (lambda (targets &rest _) targets))
              ((symbol-function 'pilish//switch-session-sections)
               (lambda (_live closed)
                 (push 'sections events)
                 (list (cons "Closed sessions" closed))))
              ((symbol-function 'pilish//pick-session-sections)
               (lambda (&rest _) (push 'picker events) nil)))
      (pilish/switch-session))
    (should (equal (nreverse events)
                   '(start await labels targets sections picker cleanup)))))

(ert-deftest pilish-local-session-prefetch-reuses-async-results ()
  "Merge async scanner results so the listing does not launch Pi again."
  (let* ((root (make-temp-file "pilish-session-prefetch-" t))
         (file (expand-file-name "session.jsonl" root))
         (pilish//session-cache (make-hash-table :test 'equal))
         (payload (make-hash-table :test 'equal))
         (record (pilish-test--metadata-record file "prefetched metadata"))
         (seen-files nil)
         (sync-calls 0))
    (puthash "sessions" (list record) payload)
    (unwind-protect
        (progn
          (with-temp-file file (insert "fixture"))
          (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
                     (lambda (_path) nil))
                    ((symbol-function 'pilish//opened-session-files)
                     (lambda () nil))
                    ((symbol-function 'pilish//entry-cwd)
                     (lambda (_file cwd) cwd))
                    ((symbol-function 'pilish//local-pi-start-async)
                     (lambda (files) (setq seen-files files) 'fake-job))
                    ((symbol-function 'pilish//local-pi-await)
                     (lambda (_job) payload))
                    ((symbol-function 'pilish//local-pi-job-cleanup)
                     (lambda (_job) nil))
                    ((symbol-function 'pilish//local-pi-run)
                     (lambda (_files) (setq sync-calls (1+ sync-calls)) nil)))
            (let* ((state (pilish//local-scan-prefetch-start root))
                   (pilish//local-scan-prefetch-state state))
              (should (equal seen-files (list file)))
              (should (eq (plist-get state :status) 'running))
              (should (pilish//local-scan-prefetch-finish state))
              (should (eq (plist-get state :status) 'complete))
              (let* ((result (pilish//local-session-entries nil root))
                     (entry (car (cdr result))))
                (should (eq (car result) t))
                (should (equal (plist-get entry :first-message)
                               "prefetched metadata"))
                (should (= sync-calls 0))))))
      (delete-directory root t))))

(ert-deftest pilish-local-prefetch-includes-registered-files-outside-root ()
  "Scan registered local session paths without adding them to discovery."
  (let* ((root (make-temp-file "pilish-scan-root-" t))
         (outside (make-temp-file "pilish-scan-outside-" t))
         (discovered (expand-file-name "discovered.jsonl" root))
         (registered (expand-file-name "registered.jsonl" outside))
         (pilish//registry
          (list (cons "outside" (list :session-file registered))
                (cons "remote" (list :session-file
                                     "/ssh:host:/tmp/remote.jsonl"))))
         (pilish//session-cache (make-hash-table :test 'equal))
         (seen-files nil))
    (unwind-protect
        (progn
          (with-temp-file discovered (insert "fixture"))
          (with-temp-file registered (insert "fixture"))
          (cl-letf (((symbol-function 'pilish//local-pi-start-async)
                     (lambda (files) (setq seen-files files) 'fake-job)))
            (let ((state (pilish//local-scan-prefetch-start root)))
              (should (equal (plist-get state :files) (list discovered)))
              (should (equal seen-files (list discovered registered))))))
      (delete-directory root t)
      (delete-directory outside t))))

