;;; session-metadata-scan-test.el --- Pilish metadata scan tests. -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defvar spacemacs-cache-directory temporary-file-directory)

(load (expand-file-name
       "funcs.el"
       (file-name-directory (or load-file-name buffer-file-name)))
      nil t)

(defun pilish-test--metadata-record (path first-message)
  "Build a scanner result for PATH with FIRST-MESSAGE."
  (let ((record (make-hash-table :test 'equal)))
    (puthash "path" path record)
    (puthash "valid" t record)
    (puthash "stable" t record)
    (puthash "cwd" "/tmp/pilish-metadata-test" record)
    (puthash "name" "cache regression" record)
    (puthash "firstMessage" first-message record)
    record))

(ert-deftest pilish-local-session-scan-recurses-and-reuses-cache ()
  "Recursive local discovery scans misses once and invalidates by file size."
  (let* ((root (make-temp-file "pilish-session-root-" t))
         (nested (expand-file-name "project/deep" root))
         (file (expand-file-name "session.jsonl" nested))
         (pilish//session-cache (make-hash-table :test 'equal))
         (calls 0)
         (seen-files nil))
    (unwind-protect
        (progn
          (make-directory nested t)
          (with-temp-file file (insert "fixture"))
          (cl-letf (((symbol-function 'pilish//opened-session-files)
                     (lambda () nil))
                    ((symbol-function 'pilish--remote-prefix-for-path)
                     (lambda (_path) nil))
                    ((symbol-function 'pilish//entry-cwd)
                     (lambda (_file cwd) cwd))
                    ((symbol-function 'pilish//local-pi-run)
                     (lambda (files)
                       (setq calls (1+ calls)
                             seen-files files)
                       (let ((payload (make-hash-table :test 'equal)))
                         (puthash "sessions"
                                  (mapcar (lambda (path)
                                            (pilish-test--metadata-record
                                             path (format "scan %d" calls)))
                                          files)
                                  payload)
                         payload))))
            (let* ((first (pilish//local-session-entries nil root))
                   (entry (car (cdr first))))
              (should (equal (car first) t))
              (should (equal seen-files (list file)))
              (should (equal (plist-get entry :first-message) "scan 1"))
              (should (equal (plist-get entry :cwd)
                             "/tmp/pilish-metadata-test"))
              ;; An unchanged warm listing must not start Pi/Node again.
              (should (equal (plist-get
                              (car (cdr (pilish//local-session-entries nil root)))
                              :first-message)
                             "scan 1"))
              (should (= calls 1))
              ;; Size participates in the signature, even when mtime is coarse.
              (with-temp-file file (insert "fixture with changed size"))
              (let ((updated (pilish//local-session-entries nil root)))
                (should (= calls 2))
                (should (equal (plist-get (car (cdr updated)) :first-message)
                               "scan 2"))))))
      (delete-directory root t))))

(ert-deftest pilish-session-open-cwd-uses-current-node-cache ()
  "Opening uses current scanner metadata without reparsing the transcript."
  (let* ((root (make-temp-file "pilish-open-cwd-cache-" t))
         (file (expand-file-name "session.jsonl" root))
         (pilish//session-cache (make-hash-table :test 'equal)))
    (unwind-protect
        (progn
          (with-temp-file file (insert "fixture"))
          (let ((attrs (file-attributes file)))
            (puthash file
                     (list :mtime (file-attribute-modification-time attrs)
                           :size (file-attribute-size attrs)
                           :metadata (list :cwd root))
                     pilish//session-cache))
          (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
                     (lambda (_path) nil))
                    ((symbol-function 'pilish--remote-home-path-p)
                     (lambda (_path) nil))
                    ((symbol-function 'pilish--emacs-directory)
                     (lambda (cwd _anchor) (file-name-as-directory cwd)))
                    ((symbol-function 'pilish//local-pi-run)
                     (lambda (_files) (error "Unexpected Node rescan")))
                    ((symbol-function 'pilish--session-file-cwd-or-error)
                     (lambda (&rest _) (error "Unexpected JSONL reread")))
                    ((symbol-function 'pilish//session-scan-info)
                     (lambda (_file) (error "Unexpected Elisp scan"))))
            ;; A mismatching entry snapshot must not override the current cache.
            (should (equal (pilish//session-file-cwd-for-open file "/tmp/stale")
                           (file-name-as-directory root)))))
      (delete-directory root t))))

(ert-deftest pilish-session-open-cwd-refreshes-stale-cache-with-node ()
  "A stale local signature is refreshed through Pi's Node scanner first."
  (let* ((root (make-temp-file "pilish-open-cwd-refresh-" t))
         (file (expand-file-name "session.jsonl" root))
         (pilish//session-cache (make-hash-table :test 'equal))
         (node-calls 0))
    (unwind-protect
        (progn
          (with-temp-file file (insert "fixture"))
          (let* ((attrs (file-attributes file))
                 (record (pilish-test--metadata-record file "preview"))
                 (payload (make-hash-table :test 'equal)))
            (puthash "cwd" root record)
            (puthash "sessions" (list record) payload)
            (puthash file
                     (list :mtime (file-attribute-modification-time attrs)
                           :size (1+ (file-attribute-size attrs))
                           :metadata (list :cwd "/tmp/stale"))
                     pilish//session-cache)
            (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
                       (lambda (_path) nil))
                      ((symbol-function 'pilish--remote-home-path-p)
                       (lambda (_path) nil))
                      ((symbol-function 'pilish--emacs-directory)
                       (lambda (cwd _anchor) (file-name-as-directory cwd)))
                      ((symbol-function 'pilish//local-pi-run)
                       (lambda (_files)
                         (setq node-calls (1+ node-calls))
                         payload))
                      ((symbol-function 'pilish--session-file-cwd-or-error)
                       (lambda (&rest _) (error "Unexpected Elisp fallback"))))
              (should (equal (pilish//session-file-cwd-for-open file "/tmp/stale")
                             (file-name-as-directory root)))
              (should (= node-calls 1)))))
      (delete-directory root t))))

(ert-deftest pilish-session-open-cwd-fails-closed-on-unstable-node-scan ()
  "An unstable Node result is retried, never trusted via Elisp rereading."
  (let* ((root (make-temp-file "pilish-open-cwd-unstable-" t))
         (file (expand-file-name "session.jsonl" root))
         (pilish//session-cache (make-hash-table :test 'equal))
         (node-calls 0))
    (unwind-protect
        (progn
          (with-temp-file file (insert "fixture"))
          (let* ((attrs (file-attributes file))
                 (record (pilish-test--metadata-record file "preview"))
                 (payload (make-hash-table :test 'equal)))
            (puthash "stable" nil record)
            (puthash "sessions" (list record) payload)
            (puthash file
                     (list :mtime (file-attribute-modification-time attrs)
                           :size (1+ (file-attribute-size attrs))
                           :metadata (list :cwd "/tmp/stale"))
                     pilish//session-cache)
            (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
                       (lambda (_path) nil))
                      ((symbol-function 'pilish//local-pi-run)
                       (lambda (_files)
                         (setq node-calls (1+ node-calls))
                         payload))
                      ((symbol-function 'pilish--session-file-cwd-or-error)
                       (lambda (&rest _) (error "Unexpected unstable fallback"))))
              (should-error (pilish//session-file-cwd-for-open file "/tmp/stale")
                            :type 'user-error)
              (should (= node-calls 2)))))
      (delete-directory root t))))

(ert-deftest pilish-session-open-cwd-rejects-remote-without-sdk-cwd ()
  "A remote open without SDK cwd fails rather than scanning JSONL over TRAMP."
  (let ((file "/ssh:build:/home/pi/.pi/agent/sessions/session.jsonl"))
    (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
               (lambda (path)
                 (and (string-prefix-p "/ssh:build:" path) "/ssh:build:")))
              ((symbol-function 'pilish--session-file-cwd-or-error)
               (lambda (&rest _) (error "Unexpected remote JSONL read"))))
      (should-error (pilish//session-file-cwd-for-open file nil)
                    :type 'user-error))))

(ert-deftest pilish-session-open-cwd-uses-remote-sdk-metadata ()
  "Remote opens pass SDK cwd to validation without scanning JSONL."
  (let* ((prefix "/ssh:build:")
         (file "/ssh:build:/home/pi/.pi/agent/sessions/session.jsonl")
         (cwd "/ssh:build:/srv/app")
         (checked nil))
    (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
               (lambda (path)
                 (and (string-prefix-p prefix path) prefix)))
              ((symbol-function 'pilish//checked-session-cwd)
               (lambda (session-file session-cwd)
                 (setq checked (list session-file session-cwd))
                 "/ssh:build:/srv/app/"))
              ((symbol-function 'pilish--session-file-cwd-or-error)
               (lambda (&rest _) (error "Unexpected remote JSONL read"))))
      (should (equal (pilish//session-file-cwd-for-open file cwd)
                     "/ssh:build:/srv/app/"))
      (should (equal checked (list file cwd))))))

