                    ((symbol-function 'pilish//local-pi-start-async)
                     (lambda (_files) 'fake-job))
                    ((symbol-function 'pilish//local-pi-await)
                     (lambda (_job) payload))
                    ((symbol-function 'pilish//local-pi-job-cleanup)
