                    ((symbol-function 'pilish//session-scan-info)
                     (lambda (_file)
                       (setq scan-calls (1+ scan-calls))
                       (error "Unexpected Elisp scan")))
                    ((symbol-function 'persp-get-by-name)
                     (lambda (&rest _) t))
                    ((symbol-function 'perspective-p)
                     (lambda (&rest _) t))
                    ((symbol-function 'pilish//chat-buffer-in-persp)
                     (lambda (&rest _) nil))
                    ((symbol-function 'pilish//registry-save)
                     (lambda (&rest _) nil))
                    ((symbol-function 'pilish//rename-persp)
