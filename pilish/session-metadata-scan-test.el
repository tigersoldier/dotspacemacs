(ert-deftest pilish-local-scan-prefetch-cancels-on-quit ()
  "A quit during label sync cancels the in-flight scan job."
  (let ((events nil))
    (cl-letf (((symbol-function 'pilish//session-root)
               (lambda () "/tmp/pilish-session-root"))
              ((symbol-function 'pilish//local-scan-prefetch-start)
               (lambda (_root) (push 'start events) 'fake-state))
              ((symbol-function 'pilish//sync-labels)
               (lambda () (push 'labels events) (signal 'quit nil)))
              ((symbol-function 'pilish//local-scan-prefetch-finish)
               (lambda (_state) (push 'await events)))
              ((symbol-function 'pilish//local-scan-prefetch-cancel)
               (lambda (_state) (push 'cleanup events)))
              ((symbol-function 'pilish//session-targets)
               (lambda (&rest _) (push 'listing events))))
      (condition-case nil
          (pilish//with-local-scan-prefetch (lambda () 'done))
        (quit nil)))
    (should (equal (nreverse events) '(start await labels cleanup)))))

(ert-deftest pilish-local-pi-job-cleanup-releases-process-and-files ()
  "Cleanup is safe for a live process and idempotent after completion."
  (let* ((buffer (generate-new-buffer " *pilish-scan-cleanup-test*"))
         (tmpdir (make-temp-file "pilish-scan-cleanup-" t))
         (process (make-process :name "pilish-scan-cleanup-test"
                                :buffer buffer
                                :command '("sh" "-c" "sleep 30")
                                :noquery t))
         (job (list :process process :buffer buffer :tmpdir tmpdir)))
    (unwind-protect
        (progn
          (pilish//local-pi-job-cleanup job)
          (should-not (process-live-p process))
          (should-not (buffer-live-p buffer))
          (should-not (file-directory-p tmpdir))
          (should-not (pilish//local-pi-job-cleanup job)))
      (when (process-live-p process)
        (delete-process process))
      (when (buffer-live-p buffer)
        (kill-buffer buffer))
      (when (file-directory-p tmpdir)
        (delete-directory tmpdir t)))))

(ert-deftest pilish-local-session-prefetch-drops-deleted-cache-hit ()
  "A cache hit deleted during label sync is not offered by the picker."
  (let* ((root (make-temp-file "pilish-session-prefetch-delete-" t))
         (file (expand-file-name "session.jsonl" root))
         (pilish//session-cache (make-hash-table :test 'equal)))
    (unwind-protect
        (progn
          (with-temp-file file (insert "fixture"))
          (let* ((attrs (file-attributes file))
                 (metadata (list :first-message "cached"
                                :message-count 1
                                :session-name "cached"
                                :cwd "/tmp/cached")))
            (puthash file
                     (list :mtime (file-attribute-modification-time attrs)
                           :size (file-attribute-size attrs)
                           :metadata metadata)
                     pilish//session-cache))
          (cl-letf (((symbol-function 'pilish--remote-prefix-for-path)
                     (lambda (_path) nil))
                    ((symbol-function 'pilish//opened-session-files)
                     (lambda () nil))
                    ((symbol-function 'pilish//entry-cwd)
                     (lambda (_file cwd) cwd))
                    ((symbol-function 'pilish//local-pi-start-async)
                     (lambda (_files) (error "Unexpected async scan"))))
            (let ((state (pilish//local-scan-prefetch-start root)))
              (should (eq (plist-get state :status) 'complete))
              (delete-file file)
              (let* ((pilish//local-scan-prefetch-state state)
                     (result (pilish//local-session-entries nil root)))
                (should (eq (car result) t))
                (should-not (cdr result))
                (should-not (gethash file pilish//session-cache))))))
      (delete-directory root t))))

(ert-deftest pilish-local-picker-omits-message-counts ()
  "File-backed local targets show their title and age without counts."
  (let* ((target (list :entry (list :file "/tmp/session.jsonl"
                                    :count 12 :modified (current-time))))
         (display (pilish//annotated-session-candidate "session" target))
         (affix (pilish//session-target-affixation
                 (list (cons "session" target))))
         (suffix (nth 2 (car (funcall affix '("session"))))))
    (should-not (string-match-p "msgs" display))
    (should-not (string-match-p "msgs" suffix))))

