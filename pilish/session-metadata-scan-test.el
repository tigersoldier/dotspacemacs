(ert-deftest pilish-local-elisp-fallback-uses-first-session-name ()
  "The Elisp fallback follows the Node scanner's first-name policy."
  (let* ((root (make-temp-file "pilish-first-name-fallback-" t))
         (file (expand-file-name "session.jsonl" root)))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "{\"type\":\"session\",\"cwd\":\"/tmp\"}\n")
            (insert "{\"type\":\"session_info\",\"name\":\"first name\"}\n")
            (insert "{\"type\":\"session_info\",\"name\":\"later name\"}\n"))
          (cl-letf (((symbol-function 'pilish-jsonl-read-session-info)
                     (lambda (_file)
                       (list :firstMessage "preview" :messageCount 2
                             :name "later name" :cwd "/tmp"))))
            (should (equal (cdr (pilish//first-session-info-name file))
                           "first name"))
            (should (equal (plist-get (pilish//session-scan-info file)
                                      :session-name)
                           "first name"))))
      (delete-directory root t))))

